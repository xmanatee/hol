# OpenAI-compatible local/self-hosted endpoint. Include the /v1 prefix.
# It must be reachable from the phone; prefer a same-origin or private HTTPS URL.
VITE_LOCAL_AI_BASE_URL=https://ai.example.test/v1
VITE_LOCAL_AI_REQUEST_TIMEOUT_MS=60000

# One multimodal model can handle both stages; use the overrides when split.
VITE_LOCAL_AI_MODEL=qwen3-vl-local
VITE_LOCAL_AI_VISION_MODEL=
VITE_LOCAL_AI_PERSONA_MODEL=
VITE_LOCAL_AI_MAX_TOKENS=300
VITE_LOCAL_AI_TEMPERATURE=0.8

# OpenAI-compatible POST /v1/audio/speech model and voice aliases.
VITE_LOCAL_AI_TTS_MODEL=kokoro-local
VITE_LOCAL_AI_TTS_VOICE=af_heart
