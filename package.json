{
  "name": "hol",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run validate:dist && npm run sbom && npm run verify:licenses",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node scripts/run-tests.mjs --suite=unit",
    "test:watch": "node scripts/run-tests.mjs --suite=unit --watch",
    "test:integration": "node scripts/run-tests.mjs --suite=integration",
    "test:all": "node scripts/run-tests.mjs --suite=all",
    "test:e2e": "playwright test",
    "test:vision": "node scripts/run-tests.mjs --suite=vision",
    "test:vision:annotated": "node scripts/test-annotated-vision-fixtures.mjs",
    "check": "npm run check:static && npm test && npm run verify:capabilities && npm run verify:depth && npm run verify:xfeat && npm run verify:head && npm run audit:anchor-flow",
    "check:all": "npm run check && npm run test:integration && npm run build && npm audit --audit-level=high && npm run check:vision && npm run test:e2e",
    "check:static": "npm run lint && npm run format:check",
    "check:vision": "npm run vision:quality && npm run vision:benchmark:quick && npm run vision:benchmark:hard && npm run test:vision:annotated",
    "audit:anchor-flow": "node scripts/audit-anchor-flow.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "validate:dist": "node scripts/validate-vision-assets.mjs && node scripts/verify-build-budget.mjs",
    "verify:capabilities": "node scripts/verify-capability-packs.mjs",
    "verify:depth": "node scripts/verify-depth-model.mjs",
    "verify:head": "node scripts/verify-head-asset.mjs",
    "verify:licenses": "node scripts/verify-open-source.mjs",
    "verify:xfeat": "node scripts/verify-xfeat-model.mjs",
    "vision:benchmark": "node scripts/vision-benchmark-matrix.mjs --summary-only",
    "vision:benchmark:full": "node scripts/vision-benchmark-matrix.mjs --full --summary-only",
    "vision:benchmark:hard": "node scripts/vision-benchmark-matrix.mjs --hard --summary-only",
    "vision:benchmark:quick": "node scripts/vision-benchmark-matrix.mjs --quick --summary-only",
    "vision:debug": "node scripts/vision-debug-report.mjs",
    "vision:experiments": "npm run build && playwright test --config=playwright.experiments.config.js --trace=off",
    "vision:feedback": "node scripts/run-vision-feedback-loop.mjs",
    "vision:feedback:full": "node scripts/run-vision-feedback-loop.mjs --full",
    "vision:feedback:hard": "node scripts/run-vision-feedback-loop.mjs --hard",
    "vision:feedback:quick": "node scripts/run-vision-feedback-loop.mjs --quick",
    "vision:probes": "node scripts/export-segmentation-probes.mjs",
    "vision:quality": "node scripts/vision-quality-report.mjs",
    "vision:report": "node scripts/vision-replay-report.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/fiber": "9.6.1",
    "lucide-react": "1.27.0",
    "onnxruntime-web": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  }
}
